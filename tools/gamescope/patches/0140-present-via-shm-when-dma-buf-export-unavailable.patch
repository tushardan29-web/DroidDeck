+    wl_buffer *CWaylandPlane::ShmReadbackBuffer( gamescope::Rc<CVulkanTexture> tex )
+    {
+        if ( tex == nullptr )
+            return nullptr;
+
+        uint32_t uStride = 0;
+        const uint8_t *pPixels = tex->ReadbackToHost( &uStride );
+        if ( pPixels == nullptr )
+            return nullptr;
+
+        const uint32_t uWidth = tex->width();
+        const uint32_t uHeight = tex->height();
+        const uint32_t uFormat = DRMFormatHasAlpha( tex->drmFormat() ) ? WL_SHM_FORMAT_ARGB8888 : WL_SHM_FORMAT_XRGB8888;
+        const uint32_t uSize = uStride * uHeight;
+
+        if ( m_uShmWidth != uWidth || m_uShmHeight != uHeight || m_uShmFormat != uFormat )
+        {
+            for ( int i = 0; i < 2; i++ )
+            {
+                if ( m_pShmBuffers[i] )
+                {
+                    wl_buffer_destroy( m_pShmBuffers[i] );
+                    m_pShmBuffers[i] = nullptr;
+                }
+                if ( m_pShmPtrs[i] )
+                {
+                    munmap( m_pShmPtrs[i], m_uShmSize );
+                    m_pShmPtrs[i] = nullptr;
+                }
+                if ( m_nShmFds[i] >= 0 )
+                {
+                    close( m_nShmFds[i] );
+                    m_nShmFds[i] = -1;
+                }
+            }
+            m_uShmWidth = uWidth;
+            m_uShmHeight = uHeight;
+            m_uShmFormat = uFormat;
+            m_uShmSize = uSize;
+        }
+
+        const unsigned uIndex = m_uShmIndex;
+        m_uShmIndex = ( m_uShmIndex + 1u ) & 1u;
+
+        if ( m_pShmBuffers[uIndex] == nullptr )
+        {
+            m_nShmFds[uIndex] = CreateShmBuffer( uSize, nullptr );
+            if ( m_nShmFds[uIndex] < 0 )
+                return nullptr;
+
+            m_pShmPtrs[uIndex] = mmap( nullptr, uSize, PROT_READ | PROT_WRITE, MAP_SHARED, m_nShmFds[uIndex], 0 );
+            if ( m_pShmPtrs[uIndex] == MAP_FAILED )
+            {
+                m_pShmPtrs[uIndex] = nullptr;
+                close( m_nShmFds[uIndex] );
+                m_nShmFds[uIndex] = -1;
+                return nullptr;
+            }
+
+            wl_shm_pool *pPool = wl_shm_create_pool( m_pBackend->GetShm(), m_nShmFds[uIndex], int32_t( uSize ) );
+            m_pShmBuffers[uIndex] = wl_shm_pool_create_buffer( pPool, 0, uWidth, uHeight, uStride, uFormat );
+            wl_shm_pool_destroy( pPool );
+
+            if ( m_pShmBuffers[uIndex] == nullptr )
+            {
+                munmap( m_pShmPtrs[uIndex], uSize );
+                m_pShmPtrs[uIndex] = nullptr;
+                close( m_nShmFds[uIndex] );
+                m_nShmFds[uIndex] = -1;
+                return nullptr;
+            }
+        }
+
+        memcpy( m_pShmPtrs[uIndex], pPixels, uSize );
+        s_uShmReadbacks++;
+        return m_pShmBuffers[uIndex];
+    }
